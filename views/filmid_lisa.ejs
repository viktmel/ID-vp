<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Viktoria Melnik, veebiprogrammeerimine</title>
</head>
<body>
<img src="../pic/veebiprogrammeerimine_2026_ID.png" alt="">
	<h1>Lisa Eesti filmid!</h1>
	<ul>
		<li><a href="/">Tagasi avalehele</a></li>
		<li><a href="/eestifilm">Tagasi Eesti filmide avalehele</a></li>
	</ul>
	<hr>
	<form method="POST">
		<label for="titleInput">Filmi pealkiri!</label>
		<input id="titleInput" name="titleInput" type="text" placeholder="Pealkiri" required>
		<br>
		<label for="releaseDateInput">Millal tuli film välja?</label>
		<input id="releaseDateInput" name="releaseDateInput" type="number" required>
		<br>
		<label for="filmLengthInput">Filmi pikkus minutites!</label>
		<input id="filmLengthInput" name="filmLengthInput" type="number">
		<br>
		<input id="movieSubmit" name="movieSubmit" type="submit" value="Salvesta">
	</form>
	<p><%= notice %></p>
</body>
</html>