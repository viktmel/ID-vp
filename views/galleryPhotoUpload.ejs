<!DOCTYPE html>
<html lang="et">
<head>
	<meta charset="utf-8">
	<title>Viktoria Melnik, veebiprogrammeerimine</title>
</head>
<body>
<img src="./pic/veebiprogrammeerimine_2026_ID.png" alt="">
	<h1>Galeriipiltide üleslaadimine</h1>
	<ul>
		<li><a href="/home">Tagasi avalehele</a></li>
		<li><a href="/logout">Logi välja</a></li>
		<li><a href="/galleryPhotoUpload/galleryPhotos">Pildigalerii</a></li>
	</ul>
	<hr>
	<form method="POST" enctype="multipart/form-data">
		<label for="photoInput">Vali pildifail (jpg)</label>
		<input id="photoInput" name="photoInput" type="file">
		<br>
		<label for="altInput">Pildi alternatiivtekst (alt)</label>
		<input id="altInput" name="altInput" type="text" placeholder="Sellel pildil on...">
		<br>
		<input id="privacyInput1" name="privacyInput" type="radio" value="1" checked>
		<label for="privacyInput1">Privaatne (ainult ise näen)</label>
		<input id="privacyInput2" name="privacyInput" type="radio" value="2">
		<label for="privacyInput2">Sisseloginud kasutajad</label>
		<input id="privacyInput3" name="privacyInput" type="radio" value="3">
		<label for="privacyInput3">Avalik (kõik näevad)</label>
		<br>
		<input id="photoSubmit" name="photoSubmit" type="submit" value="Lae üles">
	</form>
</body>
</html>